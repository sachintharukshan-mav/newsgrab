# ==========================================
# NEWSGRAB PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Canonical Site URL (Required for Sitemap, OpenGraph, Canonical tags)
NEXT_PUBLIC_SITE_URL=https://newsgrab.lk

# 2. Google AdSense & Advertising (Replace with your approved AdSense IDs)
# Your AdSense publisher client ID (format: ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Your raw AdSense publisher ID for ads.txt generation (format: pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_PUB_ID=pub-0000000000000000

# Ad Unit Slot IDs (Obtained from AdSense dashboard -> By ad unit)
NEXT_PUBLIC_ADSENSE_SLOT_TOP_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_BILLBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_MREC=
NEXT_PUBLIC_ADSENSE_SLOT_HALFPAGE=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_MULTIPLEX=
NEXT_PUBLIC_ADSENSE_DEFAULT_SLOT=

# 3. Search Engine Verification Tokens (For Google Search Console, Bing, Yandex)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# 4. Automated Feed Ingestion Cron Security
# Generate a random 32+ character string to protect /api/cron/scrape
CRON_SECRET=your_super_secret_cron_token_here
