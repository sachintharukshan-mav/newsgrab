{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsgrab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_ADSENSE_CLIENT_ID": "ca-pub-1562210028522673",
    "NEXT_PUBLIC_ADSENSE_PUB_ID": "pub-1562210028522673"
  }
}
